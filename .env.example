# docker-compose.mercure-hub.yml — copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored; this template is tracked.

# ── User/Group IDs (match host to avoid permission issues) ──
UID=1000
GID=1000

# ── Image tag ──
# This project's own tag for the vendored mercure image. Deliberately not
# mercure-dev:latest, which the ../mercure stack uses: sharing a tag means a
# rebuild on either side silently changes the image the other side runs.
HUB_TAG=mercure-hub-dev:latest

# ── Secrets ──
# NOT free to choose. ../mercure/mercure-dev/config/bookkeeper.env hardcodes
# DATABASE_URL with the password below, and ../mercure/mercure-dev/config/db.env
# holds the same value. If DB_PASSWORD here differs from that one, the
# bookkeeper starts and migrates, then fails every query on authentication.
# Read the current value from ../mercure/mercure-dev/config/db.env.
DB_PASSWORD=replace_with_the_value_from_mercure_dev_config_db_env
