# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg
*.whl

# uv
.venv/
# uv.lock is committed (review M2) — it pins exact dependency versions for
# reproducible builds.  Run `uv lock` after any pyproject.toml change.
# uv.lock

# Node / SPA build
web/node_modules/
web/*.tsbuildinfo
# Dev-only SPA overrides (web/.env.example is tracked as the template).
web/.env
# Built SPA assets — generated by `npm run build` in CI (build-spa job).
# Do not commit; they drift from source and break build verification.
src/mercure_gateway/web/static/assets/
src/mercure_gateway/web/static/index.html

# Rust / Tauri build artifacts
src-tauri/target/
src-tauri/gen/schemas/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Windows
*.exe
*.spec
*.dll
*.pdb
*.msi
*.zip

# OS
.DS_Store
Thumbs.db

# Packaging (PyInstaller, Tauri) — build/ and dist/ are also covered above.
# Runtime
/spool/
"C:\mercure-gateway\spool"/
*.db
*.db-wal
*.db-shm
mercure-gateway.json
operations.log

# Prototypes (spike artifacts, not production code)
prototypes/
benchmark-results.md

# Env & tooling artifacts
.venv/
graphify-out/
.workbuddy-ai/
.coverage
htmlcov/

# Written by the CI dependency-audit step (uv pip compile). A local re-run of
# that step leaves it behind; it is a compiled artifact, not a lockfile.
requirements-audit.txt

# Windows-path bug artifact (literal dir name created on Linux by the pre-fix
# _default_spool_dir bug) — runtime junk, never commit
C:\\mercure-gateway\\
.spool/

# Frozen backend sidecar (PyInstaller onedir, built by scripts/package_backend.py)
src-tauri/binaries/

# Local tooling artifacts — session screenshots, browser-automation logs,
# per-user Claude settings. Never project source.
.claude/settings.json
.playwright-mcp/
/live-*.png

# Playwright E2E artifacts (traces, screenshots, reports)
test-results/
playwright-report/

# Config backups written by apply-mercure-config.py before live edits.
*.bak-*
