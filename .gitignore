# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg
*.whl

# uv
.venv/
# uv.lock is committed (review M2) — it pins exact dependency versions for
# reproducible builds.  Run `uv lock` after any pyproject.toml change.
# uv.lock

# Node / SPA build
web/node_modules/
web/*.tsbuildinfo
# Dev-only SPA overrides (web/.env.example is tracked as the template).
web/.env
# Built SPA assets — generated by `npm run build` in CI (build-spa job).
# Do not commit; they drift from source and break build verification.
src/mercure_gateway/web/static/assets/
src/mercure_gateway/web/static/index.html

# Rust / Tauri build artifacts
src-tauri/target/
src-tauri/gen/schemas/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Windows
*.exe
*.spec
*.dll
*.pdb
*.msi
*.zip

# OS
.DS_Store
Thumbs.db

# Packaging (PyInstaller, Tauri) — build/ and dist/ are also covered above.
# Runtime
/spool/
"C:\mercure-gateway\spool"/
*.db
*.db-wal
*.db-shm
mercure-gateway.json
operations.log

# Prototypes (spike artifacts, not production code)
prototypes/
benchmark-results.md

# Env & tooling artifacts
.venv/
graphify-out/
.workbuddy-ai/
.coverage
# Parallel-mode per-process files (P1-6): .coverage.<host>.<pid>.<rand>
# written by subprocess coverage collection, combined at test-session finish.
.coverage.*
htmlcov/

# Written by the CI dependency-audit step (uv pip compile). A local re-run of
# that step leaves it behind; it is a compiled artifact, not a lockfile.
requirements-audit.txt

# Windows-path bug artifact (literal dir name created on Linux by the pre-fix
# _default_spool_dir bug) — runtime junk, never commit
C:\\mercure-gateway\\
.spool/

# Frozen backend sidecar (PyInstaller onedir, built by scripts/package_backend.py)
src-tauri/binaries/

# The master-password sidecar written when an appliance has no keyring
# (config/encryption.py). It is a live secret — a 0600 file holding the key to
# every encrypted secret in the config beside it. Never commit; the repo-root
# config that triggers it is itself local scratch.
*.master-password

# Local tooling artifacts — session screenshots, browser-automation logs,
# per-user Claude settings. Never project source.
.claude/settings.json
.playwright-mcp/
/live-*.png

# Playwright E2E artifacts (traces, screenshots, reports)
test-results/
playwright-report/

# Config backups written by apply-mercure-config.py before live edits.
*.bak-*

# Comprehensive-review benchmark scratch (44 MB of perf runs). The review
# reports themselves ARE tracked — every fix commit cites a finding ID
# (P0-5, P1-6...) that resolves to .full-review/05-final-report.md.
.full-review/.perfbench/

# Session worktrees (per-user scratch holding in-flight branches).
.claude/worktrees/

# OpenAPI export written by `just gen-api` (scripts/export_openapi.py). The
# SPA's committed src/types/api-schema.ts is the generated output that
# matters; the JSON is an intermediate artifact, and `just gen-api-check`
# (plus the api-schema-drift CI job) catches drift by regenerating both.
mercure-gateway.openapi.json
