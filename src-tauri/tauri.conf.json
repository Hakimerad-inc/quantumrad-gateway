{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mercure-gateway",
  "version": "0.1.0",
  "identifier": "com.mercure.gateway",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:8080",
    "frontendDist": "../src/mercure_gateway/web/static"
  },
  "app": {
    "windows": [
      {
        "title": "mercure-gateway",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:8080; connect-src 'self' http://127.0.0.1:8080; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Lightweight desktop DICOM gateway"
  }
}
