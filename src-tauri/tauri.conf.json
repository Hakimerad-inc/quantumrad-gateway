{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuantumRAD-Gateway",
  "version": "1.1.0-rc3",
  "identifier": "com.mercure.gateway",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:8080",
    "frontendDist": "../src/mercure_gateway/web/static"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1; object-src 'none'; frame-src 'self' data:; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/tray-idle.png",
      "icons/tray-sending.png",
      "icons/tray-error.png"
    ],
    "resources": ["binaries/mercure-gateway/"],
    "category": "Utility",
    "shortDescription": "Lightweight desktop DICOM gateway"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Hakimerad-inc/quantumrad-gateway/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_VIA_RELEASE_CONFIG"
    }
  }
}
