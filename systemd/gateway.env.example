# gateway.env — deployment variables consumed by the systemd user unit
# (see systemd/README.md).  Copy this file to ~/.config/mercure-gateway/gateway.env
# and `chmod 600` it.  All values are optional; the gateway falls back to the
# config file and built-in defaults for anything not set here.

# Path to the gateway config JSON (required).
MERCURE_GATEWAY_CONFIG=/home/mercure/.config/mercure-gateway/mercure-gateway.json

# Web admin API port (used by --port; the documented headless entry uses 8081).
MERCURE_GATEWAY_PORT=8081

# ── Secrets (TD-08): inject from environment, never commit ────────────────
# Hub/band audit reporting. Enabled only when a URL AND api_key are present.
# MERCURE_GATEWAY_AUDIT_HUB_REPORTING_ENABLED=true
# MERCURE_GATEWAY_AUDIT_HUB_REPORTING_BOOKKEEPER_URL=https://hub.example.com
# MERCURE_GATEWAY_AUDIT_HUB_REPORTING_API_KEY=change-me-now

# Web admin login password hash (bcrypt or sha256$salt$hash).
# MERCURE_GATEWAY_WEB_UI_AUTH_ENABLED=true
# MERCURE_GATEWAY_WEB_UI_AUTH_PASSWORD_HASH=sha256$salt$hash

# Master password for the at-rest config vault (encrypted credentials.entries).
# Prefer the file form; the file should be mode 0600 and owned by the service user.
# MERCURE_MASTER_PASSWORD_FILE=/run/secrets/gateway-master-pw
# MERCURE_MASTER_PASSWORD=change-me-now
