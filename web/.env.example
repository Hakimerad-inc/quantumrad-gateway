# Dev-only overrides for the SPA. Copy to .env (gitignored) and edit.
# Vite only exposes variables prefixed with VITE_ to the browser.

# The backend the Vite dev server proxies /api to.
#
# Default: http://127.0.0.1:8080 — what `mercure-gateway --web` binds
# (WebUIConfig) and what the Tauri sidecar expects.
#
# Override when the backend is NOT on 8080:
#   - headless systemd deployment, which documents 8081
#     (systemd/gateway.env.example: MERCURE_GATEWAY_PORT=8081)
#   - a packaged install using MERCURE_BACKEND_PORT to coexist with another
#     service on 8080 (src-tauri/src/lib.rs)
#   - two gateways on one dev box, the second started with --port
#
# This matches the SPA's runtime resolution (src/api.ts), which already reads
# VITE_API_BASE_URL for the same reason.
# VITE_API_BASE_URL=http://127.0.0.1:8081
